# Shared kiosk password gate (lib/auth.ts). Required — the app throws without it.
KIOSK_PASSWORD=

# Canva Connect integration (register a private integration at canva.com/developers)
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Optional: gate /api/canva/authorize so walk-up customers can't trigger re-auth.
# When set, connect via /api/canva/authorize?key=<this value>
CANVA_ADMIN_KEY=
# Optional: Canva folder ("project") to file each session's design into.
# Take the id from the folder's URL: canva.com/folder/<id>
# Requires the folder:write scope on the integration.
CANVA_FOLDER_ID=

# Upstash Redis (or Vercel KV) — stores the single Canva token pair
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
